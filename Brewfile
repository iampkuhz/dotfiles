# 个人 Mac 之间共享的 Homebrew 依赖。
#
# 约定：
# - 多台 Mac 都需要的工具放在这里并提交到 dotfiles。
# - 仅当前机器需要的软件写入根目录 Brewfile.local（默认不提交）。
# - 不要用 `brew bundle dump --force` 覆盖本文件，以免混入整台机器的软件快照。

# 基础开发环境
brew "git"
brew "gh"
brew "python"
brew "uv"

# 脚本与配置质量检查
brew "shellcheck"
brew "shfmt"
brew "yamlfmt"
brew "stylua"

# 编辑、文档与日常命令行工具
brew "yarn"
brew "pdf2svg"
brew "imagemagick"
brew "grip"
brew "wget"

# 模型与视频处理能力
brew "hf"
brew "ffmpeg"
brew "yt-dlp"
brew "whisper-cpp"

# 本地服务运行时
brew "podman-compose"
cask "docker"
